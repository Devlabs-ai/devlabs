{
  "version": 2,
  "readyServices": ["product-catalog-service", "redis", "postgres"],
  "terminalService": "product-catalog-service",
  "metricsService": "load-generator",
  "metricLogFormat": "METRIC latency=<float> errors=<int> dbCpu=<float>",
  "graphs": [
    {
      "symptomId": 1,
      "symptomCheck": "GET /products/2 and note name/price. PUT /products/2 with sentinel name VALIDATION_SENTINEL and price 1234.56. GET /products/2 again — still returns the OLD name/price (stale cache hit after write).",
      "graph": {
        "entry": "s1_health",
        "expectBroken": true,
        "nodes": {
          "s1_health": {
            "type": "http",
            "service": "product-catalog-service",
            "path": "/health",
            "check": { "statusOk": true },
            "onFail": "abort",
            "next": ["s1_warm"]
          },
          "s1_warm": {
            "type": "http",
            "service": "product-catalog-service",
            "path": "/products/2",
            "note": "Populate Redis via cache-aside miss",
            "next": ["s1_baseline"]
          },
          "s1_baseline": {
            "type": "http",
            "service": "product-catalog-service",
            "path": "/products/2",
            "note": "Snapshot before write",
            "next": ["s1_put"]
          },
          "s1_put": {
            "type": "http",
            "service": "product-catalog-service",
            "method": "PUT",
            "path": "/products/2",
            "body": { "name": "VALIDATION_SENTINEL", "price": "1234.56" },
            "check": { "statusOk": true },
            "next": ["s1_wait"]
          },
          "s1_wait": { "type": "wait", "ms": 150, "next": ["s1_after"] },
          "s1_after": {
            "type": "http",
            "service": "product-catalog-service",
            "path": "/products/2",
            "note": "Judge compares body to s1_baseline — expect stale (unchanged)",
            "next": []
          }
        },
        "coverage": {
          "brokenStateGoals": ["HTTP read-after-write serves pre-update values"]
        }
      }
    },
    {
      "symptomId": 2,
      "symptomCheck": "After PUT updates Postgres, redis-cli GET product:2 still holds the pre-update cached JSON (cache not invalidated on write path).",
      "graph": {
        "entry": "s2_warm",
        "expectBroken": true,
        "nodes": {
          "s2_warm": {
            "type": "http",
            "service": "product-catalog-service",
            "path": "/products/2",
            "next": ["s2_redis_before"]
          },
          "s2_redis_before": {
            "type": "exec",
            "service": "redis",
            "cmd": ["redis-cli", "GET", "product:2"],
            "note": "Snapshot Redis before write",
            "next": ["s2_put"]
          },
          "s2_put": {
            "type": "http",
            "service": "product-catalog-service",
            "method": "PUT",
            "path": "/products/2",
            "body": { "name": "SENTINEL_REDIS", "price": "99.99" },
            "check": { "statusOk": true },
            "next": ["s2_wait"]
          },
          "s2_wait": { "type": "wait", "ms": 150, "next": ["s2_redis_after"] },
          "s2_redis_after": {
            "type": "exec",
            "service": "redis",
            "cmd": ["redis-cli", "GET", "product:2"],
            "note": "Judge compares stdout to s2_redis_before — expect unchanged",
            "next": []
          }
        },
        "coverage": {
          "brokenStateGoals": ["Redis key retains stale payload after Postgres update"]
        }
      }
    },
    {
      "symptomId": 3,
      "symptomCheck": "PUT /products/3 with name StaleTestProduct and price 777.77, then GET /products/3 — response does not reflect StaleTestProduct (same invalidation bug on another product id).",
      "graph": {
        "entry": "s3_warm",
        "expectBroken": true,
        "nodes": {
          "s3_warm": {
            "type": "http",
            "service": "product-catalog-service",
            "path": "/products/3",
            "next": ["s3_put"]
          },
          "s3_put": {
            "type": "http",
            "service": "product-catalog-service",
            "method": "PUT",
            "path": "/products/3",
            "body": { "name": "StaleTestProduct", "price": "777.77" },
            "check": { "statusOk": true },
            "next": ["s3_wait"]
          },
          "s3_wait": { "type": "wait", "ms": 150, "next": ["s3_after"] },
          "s3_after": {
            "type": "http",
            "service": "product-catalog-service",
            "path": "/products/3",
            "note": "Judge checks body lacks StaleTestProduct",
            "next": []
          }
        },
        "coverage": {
          "brokenStateGoals": ["Stale read pattern reproducible on product id 3"]
        }
      }
    }
  ]
}
