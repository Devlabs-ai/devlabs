PORT=4000

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=devlabs

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL takes priority over REDIS_HOST/REDIS_PORT when set.
# REDIS_URL=redis://localhost:6379

JWT_SECRET=devlabs-dev-secret
# Optional extra admin emails (comma/space separated). Platform admin is also
# seeded as admin@devlabs.app (is_admin) on migrate.
# ADMIN_EMAILS=admin@devlabs.app

# --- Google OAuth -----------------------------------------------------------
# Create a Web client in Google Cloud → APIs & Services → Credentials.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Local (Vite proxies /api → :4000):
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# PUBLIC_APP_ORIGIN=http://localhost:5173
# Production:
# GOOGLE_REDIRECT_URI=https://devsetu.io/api/auth/google/callback
# PUBLIC_APP_ORIGIN=https://devsetu.io

# End active lab sessions after this much user inactivity (API / terminal).
# Default 20 minutes. Sweep interval defaults to 60s.
# SESSION_IDLE_TIMEOUT_MS=1200000
# SESSION_IDLE_SWEEP_MS=60000
# Shared secret so registerChallengePack can refresh the API's in-memory catalog
# without a process restart (header X-DevLabs-Reload-Token).
# CHALLENGE_RELOAD_TOKEN=devlabs-reload
# DEVLABS_BACKEND_URL=http://127.0.0.1:4000

# Static OTP for local testing only — bypasses bcrypt and always accepts
# this code. NEVER set this in production.
DEV_OTP=123456

# --- SMTP (OTP email delivery) -------------------------------------------
# Leave SMTP_HOST unset in dev — the OTP code will be printed to the console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@devlabs.app
# SALES_INBOX=sales@devlabs.app

# --- Payments (Razorpay subscriptions) --------------------------------------
# Keys: Razorpay Dashboard → Account & Settings → API Keys (rzp_test_* in test mode).
# Pricing page shows Subscribe buttons only when BILLING_ENABLED=true and keys are set.
# BILLING_ENABLED=false
# one_time (default): each purchase buys 1 month via Razorpay Orders, no auto-renew.
# subscription: auto-renewing Razorpay Subscriptions (needs Subscriptions enabled
# on the Razorpay account and the RAZORPAY_PLAN_* ids below).
# BILLING_MODE=one_time
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → URL https://<host>/api/billing/webhook, events subscription.*.
# RAZORPAY_WEBHOOK_SECRET=
# Plan ids per track — create them with: npx tsx scripts/createRazorpayPlans.ts
# RAZORPAY_PLAN_LINUX=
# RAZORPAY_PLAN_DOCKER=
# RAZORPAY_PLAN_KUBERNETES=
# RAZORPAY_PLAN_DEVOPS=
# Launch offer: percent off the first month for subscriptions created before the end date.
# LAUNCH_OFFER_PERCENT=40
# LAUNCH_OFFER_ENDS_AT=2026-10-31T23:59:59+05:30

# --- Spark workspace object store (MinIO / S3) — REQUIRED ----------------
# Spark sessions fail without MinIO.
# S3 API port is :30900. :30901 is the MinIO web console (not for the SDK).
# MINIO_ENDPOINT=http://192.168.1.2:30900
# MINIO_ACCESS_KEY=devlabs
# MINIO_SECRET_KEY=devlabs-minio-change-me
# MINIO_BUCKET=devlabs-data
# MINIO_REGION=us-east-1
# MINIO_FORCE_PATH_STYLE=true
# SPARK_PLATFORM_API_URL=http://192.168.1.2:30088
# History Server UI (fallback if platform job payload has no links.history)
# SPARK_HISTORY_UI_URL=http://192.168.1.2:30080

# --- Kubernetes labs (per-user Namespace on the shared cluster) ------------
# Required locally: without this, kubectl defaults to http://localhost:8080.
# On App EC2, docker-compose sets K8S_LAB_KUBECONFIG=/app/kube/k8s-lab.kubeconfig
# (copying remote .env alone is not enough for local EKS).
# Controller kubeconfig must create namespaces, Roles, RoleBindings, SAs, tokens.
# K8S_LAB_KUBECONFIG=/Users/you/Documents/devlabs-ai/devlabs/kube/k8s-lab.kubeconfig
# Only the App EC2 backend sets this: it scales the reserved balloons for open labs.
# A second backend with it set would fight the first (each sees only its own labs).
# K8S_CAPACITY_MANAGER=1
# K8S_LAB_CONTEXT=           # optional; omit unless you need a non-default context
# Learner SA token lifetime (kubectl create token --duration)
# K8S_LAB_TOKEN_DURATION=12h
# K8S_LAB_PROVISION_CACHE_MS=1800000
# Optional: skip parsing kubeconfig for aws eks get-token cache
# K8S_LAB_EKS_CLUSTER=devlabs
# AWS_REGION=ap-south-2
# Per-learner terminal home root (default: /Users on macOS, /home on Linux).
# Creates <root>/<user-name> (from ns-<user-name>). Falls back to ~/devlabs-homes/<user>
# if creating under /Users needs privileges.
# K8S_LAB_HOME_ROOT=/Users
# Challenge NS snapshots park at <root>/<ns>/<challengeId>.json. Keep this outside
# learner homes: snapshots are restored with controller rights. Default ~/.devlabs/k8s-snapshots
# K8S_LAB_SNAPSHOT_ROOT=
# Pod Security level enforced on learner namespaces (baseline | restricted)
# K8S_LAB_POD_SECURITY=baseline
# Only for local/dev when the CA rotated and you cannot refresh kubeconfig yet:
# K8S_LAB_INSECURE_SKIP_TLS_VERIFY=true
# Python used to run per-challenge grade/*.py (needs pyarrow for Parquet labs).
# DEVLABS_GRADE_PYTHON=/tmp/devlabs-datagen/bin/python
