PORT=4000

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=escaperoom

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL takes priority over REDIS_HOST/REDIS_PORT when set.
# REDIS_URL=redis://localhost:6379

JWT_SECRET=escape-room-dev-secret

# LLM provider for the Problem Setter chat and AI build pipeline.
# Without these, the Authoring UI still loads but chat/build are disabled.
# Set LLM_PROVIDER to "anthropic" (default) or "openai".
# LLM_PROVIDER=anthropic

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# ANTHROPIC_BASE_URL=  # optional proxy (LiteLLM, PortKey, etc.)

# OpenAI (GPT)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=  # optional proxy (LiteLLM, OpenRouter, Azure-compatible, etc.)

# Embedding model used for build-pipeline long-term memory (build_memory
# table, pgvector). Always uses the OpenAI client + OPENAI_API_KEY above,
# even when LLM_PROVIDER=anthropic, because Anthropic has no first-party
# embeddings API. Without OPENAI_API_KEY, memory degrades gracefully:
# rows are still recorded (with NULL embedding) but retrieval returns
# nothing until a key is configured and the backfill runs.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
