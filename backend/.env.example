PORT=4000

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=devlabs

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL takes priority over REDIS_HOST/REDIS_PORT when set.
# REDIS_URL=redis://localhost:6379

JWT_SECRET=devlabs-dev-secret

# --- LLM configuration ---------------------------------------------------
#
# Each authoring agent (design, schema, code, validation, embedding)
# can run on a different model. Model ids use the form "<provider>:<model>".
# Supported providers today: openai, anthropic. Adding more = a one-line
# change in backend/llm/models.js.
#
# Resolution order (per agent):
#   1. LLM_MODEL_<AGENT>     (per-agent override, e.g. LLM_MODEL_SCHEMA)
#   2. LLM_MODEL_DEFAULT     (covers all text agents)
#   3. legacy LLM_PROVIDER + OPENAI_MODEL/ANTHROPIC_MODEL
#   4. baked defaults (all OpenAI gpt-4o; validation uses gpt-4o-mini)
# Embedding follows its own track: LLM_EMBEDDING_MODEL > openai:text-embedding-3-small.

# Provider keys (set the ones you actually use)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=         # optional gateway (OpenRouter / LiteLLM / Azure / vLLM)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=      # optional gateway

# Per-agent model overrides (uncomment any to override)
# LLM_MODEL_DEFAULT=openai:gpt-4o
# LLM_MODEL_DESIGN=anthropic:claude-sonnet-4-5-20250929
# LLM_MODEL_SCHEMA=openai:gpt-4o
# LLM_MODEL_CODE=openai:gpt-4o          # challenge asset generation (build pipeline)
# LLM_MODEL_BUILD=openai:gpt-4o         # deprecated alias for LLM_MODEL_CODE
# LLM_MODEL_VALIDATION=openai:gpt-4o-mini
# LLM_EMBEDDING_MODEL=openai:text-embedding-3-small   # changing the dim breaks the lessons pgvector store

# Legacy env vars below are still honored as a fallback for existing .env
# files; new setups should prefer LLM_MODEL_* above.
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
