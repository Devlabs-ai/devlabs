PORT=4000

# Set to true to preserve sandbox/builds/<id>/ after a failed pipeline run for inspection.
# KEEP_FAILED_BUILDS=true

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=devlabs

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_URL takes priority over REDIS_HOST/REDIS_PORT when set.
# REDIS_URL=redis://localhost:6379

JWT_SECRET=devlabs-dev-secret

# Static OTP for local testing only — bypasses bcrypt and always accepts
# this code. NEVER set this in production.
DEV_OTP=123456

# --- SMTP (OTP email delivery) -------------------------------------------
# Leave SMTP_HOST unset in dev — the OTP code will be printed to the console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@devlabs.app
# SALES_INBOX=sales@devlabs.app

# --- Spark workspace object store (MinIO / S3) — REQUIRED ----------------
# Local filesystem fallback was removed. Spark sessions fail without MinIO.
# S3 API port is :30900. :30901 is the MinIO web console (not for the SDK).
# MINIO_ENDPOINT=http://192.168.1.9:30900
# MINIO_ACCESS_KEY=devlabs
# MINIO_SECRET_KEY=devlabs-minio-change-me
# MINIO_BUCKET=devlabs-data
# MINIO_REGION=us-east-1
# MINIO_FORCE_PATH_STYLE=true
# SPARK_PLATFORM_API_URL=http://192.168.1.9:30088
# History Server UI (fallback if platform job payload has no links.history)
# SPARK_HISTORY_UI_URL=http://192.168.1.9:30080

# --- LLM configuration ---------------------------------------------------
#
# Model ids use the format "<provider>:<model>".
# Supported providers: openai, anthropic
#
# Resolution order (highest → lowest priority):
#   1. LLM_MODEL_<AGENT>   — per-agent override (e.g. LLM_MODEL_DESIGN)
#   2. LLM_MODEL_DEFAULT   — single override for all text agents
#   3. Baked-in defaults   — see backend/llm/models.js DEFAULTS

# CODE phase uses Claude Agent SDK (Claude Code harness) — requires ANTHROPIC_API_KEY.
# Model from LLM_MODEL_CODE (must be anthropic:*, e.g. anthropic:claude-haiku-4-5).
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=              # optional: OpenRouter / LiteLLM / Azure / vLLM
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=           # optional: Anthropic-compatible gateway

# --- Per-agent model config ----------------------------------------------
#
# Agent       Role                              Baked default
# ─────────── ───────────────────────────────── ─────────────────────────
# design      Phase 1 chat with interviewer     anthropic:claude-haiku-4-5
# schema      Phase 2 draft materialisation     anthropic:claude-haiku-4-5
# code        Build pipeline (Claude Agent SDK)   anthropic:claude-haiku-4-5
# validation  Build pipeline judge              anthropic:claude-haiku-4-5
# embedding   Lesson store similarity search    openai:text-embedding-3-small
#
# LLM_MODEL_DESIGN=anthropic:claude-haiku-4-5
# LLM_MODEL_SCHEMA=anthropic:claude-haiku-4-5
# LLM_MODEL_CODE=anthropic:claude-haiku-4-5
# LLM_MODEL_VALIDATION=anthropic:claude-haiku-4-5
#
# --- Spark authoring (Claude Agent SDK for Data/Code) --------------------
# SPARK_PIPELINE_MAX_ITERATIONS=2
# SPARK_DATA_MAX_TURNS=25
# SPARK_CODE_MAX_TURNS=35
# SPARK_EVAL_DATA_GEN_MODE=k8s   # k8s (default) | local — data gen via platforms/devlabs-data Job
# DEVLABS_NAMESPACE=devlabs
# DEVLABS_DATA_IMAGE=rithvikreddyalkanti/devlabs-data-tools:latest
# DEVLABS_DATA_JOB_TIMEOUT_MS=900000
# DEVLABS_DATA_JOB_TEMPLATE=     # optional absolute path to job-generate-authoring.yaml
# MINIO_INCLUSTER_ENDPOINT=http://minio.minio.svc.cluster.local:9000
# KUBECONFIG=                    # required for SPARK_EVAL_DATA_GEN_MODE=k8s
# SPARK_EVAL_PYTHON=python3      # only used when DATA_GEN_MODE=local
# SPARK_EVAL_SOLUTION_CMD=          # optional: shell that runs solution on Spark platform
# SPARK_EVAL_REPAIR=                # set to 1 to allow Claude repair inside Eval on failure
# SPARK_AUTHORING_DIR=              # default: sandbox/spark-authoring
# LLM_MODEL_SPARK_DATA=anthropic:claude-haiku-4-5
# LLM_MODEL_SPARK_CODE=anthropic:claude-haiku-4-5
# LLM_MODEL_SPARK_VALIDATION=openai:gpt-4o-mini
# LLM_MODEL_SPARK_EVAL_REPAIR=anthropic:claude-haiku-4-5
#
# --- Mix providers (CODE must stay Anthropic) ----------------------------
# LLM_MODEL_DESIGN=anthropic:claude-haiku-4-5
# LLM_MODEL_SCHEMA=openai:gpt-4o
# LLM_MODEL_VALIDATION=openai:gpt-4o-mini
#
# --- Budget Anthropic setup (default for pipeline agents) ----------------
# schema / code / validation use Claude Haiku 4.5 (~fast, cost-efficient).
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
# OPENAI_API_KEY=sk-...                        # required for embeddings
#
# Optional overrides:
# LLM_MODEL_SCHEMA=anthropic:claude-haiku-4-5
# LLM_MODEL_CODE=anthropic:claude-haiku-4-5
# LLM_MODEL_VALIDATION=anthropic:claude-haiku-4-5
# LLM_MODEL_DESIGN=anthropic:claude-haiku-4-5
#
# --- Blanket override ----------------------------------------------------
# LLM_MODEL_DEFAULT=anthropic:claude-haiku-4-5
#
# --- Embedding (changing the model breaks the pgvector lessons store) ----
# LLM_EMBEDDING_MODEL=openai:text-embedding-3-small
#
# --- Legacy fallback (still honoured; prefer LLM_MODEL_* for new setups) -
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
