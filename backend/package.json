{
  "name": "devlabs-backend",
  "version": "0.1.0",
  "description": "Devlabs backend (Express + WebSocket + Postgres + Redis)",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'); for (const d of ['darwin-arm64','darwin-x64','linux-arm64','linux-x64']) { const f=p.join('node_modules','node-pty','prebuilds',d,'spawn-helper'); if (fs.existsSync(f)) { try { fs.chmodSync(f,0o755); } catch(_) {} } }\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "node-pty": "^1.1.0",
    "nodemailer": "^8.0.10",
    "pg": "^8.12.0",
    "uuid": "^9.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "nodemon": "^3.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
