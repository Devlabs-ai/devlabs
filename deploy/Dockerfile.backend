FROM node:20-bookworm-slim

# docker-compose-plugin is not in Debian bookworm apt; install the CLI plugin manually.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl docker.io \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /usr/local/lib/docker/cli-plugins \
  && curl -fsSL "https://github.com/docker/compose/releases/download/v2.24.5/docker-compose-linux-$(uname -m)" \
    -o /usr/local/lib/docker/cli-plugins/docker-compose \
  && chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

WORKDIR /app

COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

COPY backend/ ./
COPY sandbox/verified/ /app/sandbox/verified/

# node-pty native binary for linux x64 in the image
RUN npm run postinstall 2>/dev/null || true

ENV NODE_ENV=production
EXPOSE 4000

CMD ["node", "server.js"]
