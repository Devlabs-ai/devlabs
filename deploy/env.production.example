# Copy to /opt/devlabs/.env on the EC2 host (or backend/.env when running backend on the host).
# Replace PUBLIC_HOST with your Elastic IP or EC2 public IPv4.

# --- Public access (no custom domain yet) ---
# Used in logs/docs for invite links; frontend uses window.location.origin for invites.
PUBLIC_HOST=54.0.0.0

# --- Backend ---
PORT=4000
NODE_ENV=production

# --- Postgres (docker-compose.prod.yml service name: postgres) ---
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME_STRONG
PGDATABASE=devlabs

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Or: REDIS_URL=redis://redis:6379

# --- Auth (change before exposing to the internet) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM

# --- LLM (full platform: authoring + build pipeline + lesson embeddings) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Embeddings for Memories / lessons (OpenAI even when LLM_PROVIDER=anthropic)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
