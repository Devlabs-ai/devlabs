# Copy to /opt/devlabs/.env on the EC2 host.
# Replace PUBLIC_HOST with your Elastic IP.

# --- Public access ---
# Domain (preferred) or Elastic IP while DNS is settling.
PUBLIC_HOST=devsetu.io

# --- Backend ---
PORT=4000
NODE_ENV=production

# --- Postgres (docker-compose.prod.yml service name: postgres) ---
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME_STRONG
PGDATABASE=devlabs

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Or: REDIS_URL=redis://redis:6379

# --- Auth (change before exposing to the internet) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM
# SESSION_IDLE_TIMEOUT_MS=1200000
# SESSION_IDLE_SWEEP_MS=60000

# Optional: allow console OTP in emergencies only. Never set on a shared beta.
# DEV_OTP=
# Optional extra admin emails (platform admin admin@devlabs.app is seeded on migrate).
# ADMIN_EMAILS=admin@devlabs.app

# --- Google OAuth -----------------------------------------------------------
# Paste Client ID / secret from Google Cloud Console (Web application client).
# Redirect URI in Google Console must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://devsetu.io/api/auth/google/callback
PUBLIC_APP_ORIGIN=https://devsetu.io


# --- Object store (S3) — required for Spark Play later ---
# Use your beta bucket in the same region as the EC2.
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_REGION=ap-south-1
# S3_BUCKET=devlabs-beta-data-YOURNAME
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Path-style is usually false for real AWS S3:
# S3_FORCE_PATH_STYLE=false
#
# Legacy MinIO names still work if you prefer:
# MINIO_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# MINIO_REGION=ap-south-1
# MINIO_BUCKET=devlabs-beta-data-YOURNAME
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_FORCE_PATH_STYLE=false

# --- Kubernetes labs (controller kubeconfig mounted at /app/kube/…) ---
# K8S_LAB_KUBECONFIG=/app/kube/k8s-lab.kubeconfig
# Learner homes persist on the host via compose mount ./kube/homes:/home
# K8S_LAB_HOME_ROOT=/home
# Lab snapshots: backend-only mount ./kube/snapshots (set in docker-compose.prod.yml)
# K8S_LAB_SNAPSHOT_ROOT=/app/kube/snapshots
# Pod Security level enforced on learner namespaces (baseline | restricted)
# K8S_LAB_POD_SECURITY=baseline
# Lab terminals run in isolated containers (K8S_LAB_SHELL_MODE=container, set in
# docker-compose.prod.yml). Build the image once per deploy:
#   docker compose -f docker-compose.prod.yml build lab-shell
# DEVLABS_ROOT=/opt/devlabs   # repo path on the host, if not /opt/devlabs
# AWS_* below must be an IAM user with EKS Access Entry (ClusterAdmin)
# so `aws eks get-token` inside the backend container works.
# Keep S3 credentials in MINIO_* (or S3_*) so they don't collide.

# Lab visibility + tokens come from backend/challenges/packs on deploy; admin UI edits are blocked.
CATALOG_SETTINGS_LOCKED=true
