# Copy to /opt/devlabs/.env on the EC2 host (or backend/.env when running backend on the host).
# Replace PUBLIC_HOST with your Elastic IP or EC2 public IPv4.

# --- Public access (no custom domain yet) ---
PUBLIC_HOST=54.0.0.0

# --- Backend ---
PORT=4000
NODE_ENV=production

# --- Postgres (docker-compose.prod.yml service name: postgres) ---
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME_STRONG
PGDATABASE=devlabs

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Or: REDIS_URL=redis://redis:6379

# --- Auth (change before exposing to the internet) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM

# --- Spark / MinIO (required for spark-platform Play sessions) ---
# MINIO_ENDPOINT=http://...
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=devlabs-data
# SPARK_PLATFORM_API_URL=http://...
