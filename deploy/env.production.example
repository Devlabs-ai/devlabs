# Copy to /opt/devlabs/.env on the EC2 host (or backend/.env when running backend on the host).
# Replace PUBLIC_HOST with your Elastic IP or EC2 public IPv4.

# --- Public access (no custom domain yet) ---
# Used in logs/docs for invite links; frontend uses window.location.origin for invites.
PUBLIC_HOST=54.0.0.0

# --- Backend ---
PORT=4000
NODE_ENV=production

# --- Postgres (docker-compose.prod.yml service name: postgres) ---
PGHOST=postgres
PGPORT=5432
PGUSER=postgres
PGPASSWORD=CHANGE_ME_STRONG
PGDATABASE=devlabs

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
# Or: REDIS_URL=redis://redis:6379

# --- Auth (change before exposing to the internet) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM

# --- LLM (full platform: authoring + build pipeline + lesson embeddings) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_MODEL_DEFAULT=anthropic:claude-haiku-4-5
LLM_MODEL_DESIGN=anthropic:claude-haiku-4-5
LLM_MODEL_SCHEMA=anthropic:claude-haiku-4-5
LLM_MODEL_CODE=anthropic:claude-haiku-4-5
LLM_MODEL_VALIDATION=anthropic:claude-haiku-4-5
# Embeddings still use OpenAI (pgvector schema is fixed at text-embedding-3-small dim).
OPENAI_API_KEY=
LLM_EMBEDDING_MODEL=openai:text-embedding-3-small
