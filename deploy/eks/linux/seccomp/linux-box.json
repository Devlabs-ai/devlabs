        "swapon",
        "swapoff",
        "iopl",
        "ioperm",
        "syslog",
        "lookup_dcookie",
        "nfsservctl",
        "quotactl",
        "quotactl_fd",
        "uselib",
        "vm86",
        "vm86old"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
